# IA dos agentes. O jeito mais simples e o assistente de configuracao inicial,
# que abre na primeira visita a interface e tambem em Configuracoes. Os valores
# abaixo sao os padroes de uma instalacao nova; depois, o que for salvo pela
# interface prevalece.
#   ollama (padrao), anthropic, openai ou gemini
LLM_PROVIDER=ollama

# Chaves de API dos provedores na nuvem. Opcionais: o assistente tambem guarda a
# chave (num arquivo do volume de dados, nunca no Redis nem no log). Uma chave
# definida aqui tem prioridade sobre a do assistente.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Modelos de cada provedor na nuvem.
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   (troque para OpenRouter, Groq, Azure OpenAI ou vLLM)
# GEMINI_MODEL=gemini-2.5-flash

# Quem gera os embeddings: ollama (padrao), openai, gemini ou simulado.
# EMBEDDING_PROVIDER=ollama

# Onde esta o Ollama.
#   Na propria maquina (padrao):  http://host.docker.internal:11434
#   Em outra maquina da rede:     http://192.168.0.10:11434
#   No container do perfil ollama: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Modelo que gera os embeddings dos eventos (busca semantica e agente de perguntas).
EMBEDDING_MODEL=nomic-embed-text

# Quando o Ollama estiver fora do ar: false = os casos aguardam; true = agente heuristico simulado.
HEURISTIC_FALLBACK_ENABLED=false

# Revisao humana: SE_REPROVADO ou SEMPRE.
HUMAN_REVIEW_MODE=SE_REPROVADO

# Atraso visual por estagio (ms) e falhas injetadas por operacao (%).
STAGE_DELAY_MS=700
FAILURE_RATE_PERCENT=0

# Porta da interface.
UI_PORT=8580

# Porta do Ollama em container (perfil ollama) na maquina. Mude se a 11434
# ja estiver em uso por outro Ollama.
OLLAMA_PORT=11434
