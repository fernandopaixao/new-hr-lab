# Onde esta o Ollama.
#   Na propria maquina (padrao):  http://host.docker.internal:11434
#   Em outra maquina da rede:     http://192.168.0.10:11434
#   No container do perfil ollama: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Quando o Ollama estiver fora do ar: false = os casos aguardam; true = agente heuristico simulado.
HEURISTIC_FALLBACK_ENABLED=false

# Revisao humana: SE_REPROVADO ou SEMPRE.
HUMAN_REVIEW_MODE=SE_REPROVADO

# Atraso visual por estagio (ms) e falhas injetadas por operacao (%).
STAGE_DELAY_MS=700
FAILURE_RATE_PERCENT=0

# Porta da interface.
UI_PORT=8080
